:root {
  --bg: #0b0c10;
  --panel: #131418;
  --panel-raised: #17181d;
  --ink: #f3f4f6;
  --ink-soft: #9a9ca6;
  --ink-dim: #6b6d78;
  --line: rgba(255, 255, 255, 0.08);
  --line-bright: rgba(255, 255, 255, 0.14);
  --accent: #5b8def;
  --accent-ink: #eaf1ff;
  --good: #3ecf8e;
  --warn: #e0a930;
  --bad: #f0575e;
  --radius: 12px;
  --radius-sm: 8px;
  box-sizing: border-box;
}
* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
  position: relative;
}
h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.01em; }
.mono { font-family: 'JetBrains Mono', monospace; }
::selection { background: var(--accent); color: #fff; }

/* Background: one quiet gradient wash, no orbs, no noise, no grid. */
.bg-field { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
.glow {
  position: absolute; top: -20%; left: 50%; transform: translateX(-50%);
  width: 900px; height: 500px; max-width: 140vw;
  background: radial-gradient(ellipse at center, rgba(91, 141, 239, 0.14), transparent 70%);
}

/* ---------------------------------------------------------------------- */
/* Landing page                                                            */
/* ---------------------------------------------------------------------- */
.landing-page { position: relative; z-index: 1; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 80px 20px 60px; }
.landing-login-btn { position: absolute; top: 24px; right: 24px; z-index: 2; }
.landing-inner { max-width: 720px; width: 100%; text-align: center; }
.landing-title { font-size: clamp(40px, 8vw, 58px); font-weight: 700; margin: 0 0 16px; color: #fff; letter-spacing: -0.02em; }
.landing-tagline { font-size: 16px; color: var(--ink-soft); line-height: 1.6; max-width: 58ch; margin: 0 auto 28px; }
.landing-cta-row { display: flex; justify-content: center; gap: 12px; margin-bottom: 32px; }
.landing-cta { padding: 13px 32px; font-size: 15px; }

.landing-example { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; margin-bottom: 32px; text-align: left; }
.landing-example-label { font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-dim); margin-bottom: 14px; }
.landing-example-card { display: flex; gap: 18px; align-items: center; margin-bottom: 18px; }
.landing-score { font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 700; color: var(--good); flex-shrink: 0; }
.landing-score span { font-size: 16px; color: var(--ink-dim); font-weight: 500; }
.landing-example-verdict { font-weight: 700; font-size: 15px; margin-bottom: 4px; }
.landing-example-text p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.5; margin: 0; }
.landing-example-bars { display: flex; flex-direction: column; gap: 8px; }
.landing-example-bar-row { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--ink-dim); }
.landing-example-bar-row span { width: 60px; flex-shrink: 0; }
.landing-example-bar-track { flex: 1; height: 10px; background: rgba(255,255,255,0.05); border-radius: 5px; overflow: hidden; }
.landing-example-bar { height: 100%; border-radius: 5px; }
.landing-example-bar.in { background: var(--good); }
.landing-example-bar.out { background: var(--warn); }

.landing-features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 36px; text-align: left; }
.landing-feature { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 16px 18px; }
.landing-feature h3 { font-size: 14px; margin: 0 0 6px; color: #fff; }
.landing-feature p { font-size: 13px; color: var(--ink-soft); line-height: 1.5; margin: 0; }

.landing-sim-chart { width: 100%; height: 180px; display: block; }
.landing-sim-legend { display: flex; gap: 18px; margin-top: 10px; font-size: 12.5px; color: var(--ink-soft); }
.landing-sim-legend-item { display: flex; align-items: center; gap: 6px; }

@media (max-width: 560px) {
  .landing-features { grid-template-columns: 1fr; }
  .landing-example-card { flex-direction: column; align-items: flex-start; }
}

/* ---------------------------------------------------------------------- */
/* Sign-in page                                                            */
/* ---------------------------------------------------------------------- */
.auth-page { position: relative; z-index: 1; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
.auth-page-inner { max-width: 380px; width: 100%; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px 28px; }
.auth-page-inner h2 { font-size: 21px; margin: 0 0 8px; color: #fff; text-align: center; }
.auth-page-sub { font-size: 13.5px; color: var(--ink-soft); text-align: center; margin: 0 0 22px; line-height: 1.5; }
.auth-page-switch { text-align: center; font-size: 13px; color: var(--ink-soft); margin: 16px 0 0; }
.auth-page-switch a { color: var(--accent); text-decoration: none; }
.auth-page-switch a:hover { text-decoration: underline; }
.auth-back-btn { width: 100%; margin-top: 14px; }

/* ---------------------------------------------------------------------- */
/* App shell: sticky left step nav, main column, sticky right account rail */
/* ---------------------------------------------------------------------- */
.app-shell {
  position: relative; z-index: 1; display: flex; gap: 28px; align-items: flex-start;
  max-width: 1180px; margin: 0 auto; padding: 40px 20px 90px;
}
.main-col { flex: 1; min-width: 0; max-width: 760px; margin: 0 auto; }

.side-nav {
  position: sticky; top: 40px; width: 210px; flex-shrink: 0;
  display: flex; flex-direction: column; gap: 3px;
}
.side-nav-title { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 700; color: #fff; margin-bottom: 14px; padding: 0 10px; }
.side-nav-divider { height: 1px; background: var(--line); margin: 8px 10px 10px; }
.side-nav-item {
  display: flex; align-items: center; gap: 10px; text-align: left;
  background: none; border: none; border-radius: var(--radius-sm); padding: 10px 10px;
  font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 500; color: var(--ink-soft);
  cursor: pointer; transition: background .15s ease, color .15s ease;
}
.side-nav-item:hover:not(.locked) { background: var(--panel-raised); color: #fff; }
.side-nav-item.active { background: rgba(91,141,239,0.1); color: #fff; font-weight: 600; }
.side-nav-item.locked { opacity: .4; cursor: not-allowed; }
.side-nav-num {
  display: inline-flex; align-items: center; justify-content: center; width: 8px; height: 8px; flex-shrink: 0;
  border-radius: 50%; background: var(--line-bright);
}
.side-nav-item.active .side-nav-num { background: var(--accent); }
.side-nav-num.done { background: var(--good); }

.account-rail { position: sticky; top: 40px; width: 190px; flex-shrink: 0; }
.account-rail-inner { display: flex; flex-direction: column; gap: 8px; }
.account-profile { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; padding: 4px 2px; }
.account-avatar {
  width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff;
  display: flex; align-items: center; justify-content: center; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 15px; flex-shrink: 0;
}
.account-email { font-size: 12px; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rail-btn { width: 100%; text-align: left; padding: 9px 12px; font-size: 12.5px; }

@media (max-width: 980px) {
  .app-shell { flex-direction: column; }
  .side-nav, .account-rail { position: static; width: 100%; flex-direction: row; flex-wrap: wrap; top: auto; }
  .side-nav-divider { display: none; }
  .account-rail-inner { flex-direction: row; flex-wrap: wrap; }
  .rail-btn { width: auto; }
}

.case-page {
  border: 1px solid var(--line); border-radius: var(--radius);
  background: var(--panel); padding: 32px clamp(18px, 4vw, 40px) 38px;
}

.round-label { font-size: 12.5px; font-weight: 600; color: var(--accent); margin-bottom: 8px; }
.case-page h2 { font-size: clamp(21px, 3vw, 25px); margin: 0 0 8px; font-weight: 600; color: #fff; }
.case-page > .dek { color: var(--ink-soft); font-size: 14.5px; line-height: 1.6; max-width: 62ch; margin: 0 0 26px; }

.field { margin-bottom: 18px; }
.field label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--ink); }
.field .hint { font-size: 12px; color: var(--ink-dim); margin-top: 6px; }
textarea, input[type=text], input[type=number], input[type=password], select {
  width: 100%; font-family: 'Inter', sans-serif; font-size: 14.5px; padding: 11px 13px;
  border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel-raised); color: var(--ink);
  outline: none; resize: vertical; transition: border-color .15s ease;
}
textarea::placeholder, input::placeholder { color: var(--ink-dim); }
textarea:focus, input:focus, select:focus { border-color: var(--accent); }
textarea { min-height: 100px; line-height: 1.55; }

/* ---- Buttons: flat, no glow, no shimmer ---- */
button.primary {
  background: var(--accent); color: #fff; border: none; padding: 11px 20px; border-radius: var(--radius-sm);
  font-family: 'Inter', sans-serif; font-weight: 600; font-size: 14px; cursor: pointer;
  transition: background .15s ease;
}
button.primary:hover:not(:disabled) { background: #6f9bf2; }
button.primary:active:not(:disabled) { background: #4d7cd6; }
button.primary:disabled { opacity: 0.5; cursor: not-allowed; }

button.ghost {
  background: transparent; border: 1px solid var(--line); color: var(--ink-soft); padding: 9px 15px;
  border-radius: var(--radius-sm); font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 500; cursor: pointer;
  transition: border-color .15s ease, color .15s ease;
}
button.ghost:hover { border-color: var(--line-bright); color: #fff; }

/* ---- Loading ---- */
.loading-line { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--ink-soft); padding: 16px 0; }
.spinner {
  width: 15px; height: 15px; border-radius: 50%; flex-shrink: 0;
  border: 2px solid var(--line); border-top-color: var(--accent);
  animation: spin-loader 0.7s linear infinite;
}
@keyframes spin-loader { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }

/* ---- Round 1: verdict ---- */
.verdict { display: flex; gap: 22px; align-items: center; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); flex-wrap: wrap; }
.stamp {
  min-width: 92px; padding: 14px 18px; border-radius: var(--radius); text-align: center;
  background: var(--panel-raised); border: 1px solid var(--line-bright);
}
.stamp .score { font-family: 'Space Grotesk', sans-serif; font-size: 32px; font-weight: 700; line-height: 1; color: var(--bad); }
.stamp.mid .score { color: var(--warn); }
.stamp.pos .score { color: var(--good); }
.stamp .of100 { font-size: 10px; color: var(--ink-dim); letter-spacing: 0.06em; margin-top: 4px; }
.verdict-text { flex: 1; min-width: 220px; }
.verdict-text .call { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 600; color: #fff; margin-bottom: 6px; }
.verdict-text p { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0; }

.evidence-list { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 8px; }
.evidence-list li {
  font-size: 13.5px; line-height: 1.5; padding: 11px 13px; border-radius: var(--radius-sm);
  background: var(--panel-raised); border: 1px solid var(--line); color: var(--ink);
  border-left: 2px solid var(--good);
}
.evidence-list li.risk { border-left-color: var(--bad); }
.evidence-list li .tag {
  display: inline-block; font-size: 10.5px; text-transform: uppercase; font-weight: 600;
  letter-spacing: 0.04em; color: var(--good); margin-right: 8px; opacity: 0.9;
}
.evidence-list li.risk .tag { color: var(--bad); }

/* ---- Round 2: model cards + money flow ---- */
.model-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
.model-card {
  background: var(--panel-raised); border: 1px solid var(--line); border-radius: var(--radius); padding: 15px 17px;
}
.model-card h3 {
  font-size: 12px; margin: 0 0 8px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;
}
@media (max-width: 600px) { .model-grid { grid-template-columns: 1fr; } }

.money-flow {
  margin-top: 22px; padding: 20px; border-radius: var(--radius);
  background: var(--panel-raised); border: 1px solid var(--line);
}
.flow-row { display: grid; grid-template-columns: 110px 1fr 76px; align-items: center; gap: 12px; margin-bottom: 10px; }
.flow-label { font-size: 12.5px; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.flow-bar-track { height: 7px; border-radius: 5px; background: var(--line); overflow: hidden; }
.flow-bar { height: 100%; border-radius: 5px; background: var(--accent); }
.flow-bar.invest { background: var(--ink-dim); }
.flow-val { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; text-align: right; color: var(--ink); }

/* ---- Round 3: tax tables ---- */
.deduction-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; }
.deduction-table th {
  text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-dim);
  padding: 8px 10px; border-bottom: 1px solid var(--line-bright); font-weight: 600;
}
.deduction-table td { padding: 10px; border-bottom: 1px solid var(--line); color: var(--ink); }
.deduction-table td.line { color: var(--accent); font-family: 'JetBrains Mono', monospace; font-size: 12px; }
.firm-card {
  border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 13px 15px; margin-bottom: 8px;
  background: var(--panel-raised);
}
.firm-card .name { font-weight: 600; font-size: 14px; color: #fff; margin-bottom: 3px; }
.firm-card .desc { font-size: 13px; color: var(--ink-soft); line-height: 1.5; }

.structure-rec {
  background: rgba(91,141,239,0.06); border: 1px solid rgba(91,141,239,0.25);
  border-radius: var(--radius-sm); padding: 14px 16px; margin: 22px 0;
}
.structure-rec-entity { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 700; color: var(--accent); }

/* ---- Footer / misc ---- */
.footer-row { display: flex; gap: 10px; justify-content: flex-end; margin-top: 22px; flex-wrap: wrap; }
.small-note { font-size: 12px; color: var(--ink-dim); text-align: center; margin-top: 26px; line-height: 1.6; }
.empty-note {
  font-size: 13.5px; color: var(--ink-dim); background: var(--panel-raised); border: 1px solid var(--line);
  border-radius: var(--radius-sm); padding: 15px 16px; line-height: 1.55;
}
.empty-note.small { font-size: 13px; padding: 10px 0; background: none; border: none; }

/* ---- Modals ---- */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); display: flex;
  align-items: center; justify-content: center; z-index: 100; padding: 20px;
}
.modal {
  background: var(--panel); border: 1px solid var(--line-bright); border-radius: var(--radius);
  padding: 26px 24px; width: 100%; max-width: 380px; position: relative;
  box-shadow: 0 20px 50px -12px rgba(0,0,0,0.6);
  max-height: calc(100vh - 40px); overflow-y: auto;
}
.modal-close {
  position: absolute; top: 12px; right: 14px; background: none; border: none; font-size: 20px;
  cursor: pointer; color: var(--ink-dim); line-height: 1;
}
.modal-close:hover { color: #fff; }
.modal-tabs { display: flex; gap: 6px; margin-bottom: 18px; }
.modal-tab {
  flex: 1; background: var(--panel-raised); border: 1px solid var(--line); border-radius: var(--radius-sm);
  padding: 8px 10px; font-size: 13px; font-weight: 600; color: var(--ink-soft); cursor: pointer;
  transition: all .15s ease;
}
.modal-tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.auth-error {
  font-size: 12.5px; color: var(--bad); background: rgba(240, 87, 94, 0.08); border: 1px solid rgba(240, 87, 94, 0.25);
  border-radius: var(--radius-sm); padding: 9px 11px; margin-bottom: 14px;
}
.saved-item {
  border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px 14px; margin-bottom: 8px;
  display: flex; justify-content: space-between; align-items: center; gap: 10px; background: var(--panel-raised);
}
.saved-item .saved-info { flex: 1; min-width: 0; }
.saved-item .saved-name { font-family: 'Space Grotesk', sans-serif; font-size: 14.5px; margin: 0 0 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; }
.saved-item .saved-meta { font-size: 11.5px; color: var(--ink-dim); }
.saved-item .saved-actions { display: flex; gap: 6px; flex-shrink: 0; }
.saved-item button { padding: 6px 10px; font-size: 12px; }

/* ---- Subtle, purposeful motion only ---- */
.case-page { animation: fadeIn .2s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.reveal-item { animation: itemIn .25s ease both; }
@keyframes itemIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  .case-page, .reveal-item { animation: none !important; }
}

@media (max-width: 480px) {
  .tab { font-size: 13px; margin-right: 14px; }
  .verdict { flex-direction: row; }
}

/* ---- Source citation buttons + tooltip ---- */
.cite-btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 16px; height: 16px; margin-left: 7px; flex-shrink: 0;
  border-radius: 50%; border: 1px solid var(--accent);
  background: rgba(91, 141, 239, 0.12); color: var(--accent);
  font-size: 10px; font-weight: 700; font-style: italic; line-height: 1;
  cursor: pointer; vertical-align: middle; padding: 0;
  transition: background .15s ease, transform .1s ease;
}
.cite-btn:hover, .cite-btn:focus-visible { background: var(--accent); color: #fff; transform: scale(1.08); }
.cite-btn.cite-btn-none { border-color: var(--line); background: transparent; color: var(--ink-dim); }
.cite-btn.cite-btn-none:hover, .cite-btn.cite-btn-none:focus-visible { background: var(--panel-raised); color: var(--ink-soft); transform: none; }

.cite-tooltip {
  position: absolute; z-index: 500; max-width: 280px;
  background: var(--panel-raised); border: 1px solid var(--line); border-radius: var(--radius-sm);
  padding: 10px 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.35);
  font-size: 12.5px; line-height: 1.5;
}
.cite-tooltip-label { font-size: 10.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-dim); margin-bottom: 4px; }
.cite-tooltip a { color: var(--accent); text-decoration: none; word-break: break-word; }
.cite-tooltip a:hover { text-decoration: underline; }
.cite-tooltip-body { color: var(--ink-soft); }

/* ---- Round 2/3 readability pass ---- */
.evidence-list li { display: flex; align-items: flex-start; gap: 8px; }
.money-flow-split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.money-panel { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 14px 16px; background: var(--panel-raised); }
.money-panel h4 { margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: .01em; }
.money-panel.in-panel h4 { color: #3ecf8e; }
.money-panel.out-panel h4 { color: #e0a13f; }
.money-panel .flow-row { margin-bottom: 14px; }
.money-panel .flow-row-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 5px; gap: 10px; }
.money-panel .flow-label { font-size: 12.5px; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.money-panel .flow-amount { font-size: 12.5px; font-weight: 700; color: var(--ink); flex-shrink: 0; }
.money-panel .flow-bar-track { background: rgba(255,255,255,0.05); border-radius: 6px; overflow: hidden; height: 10px; }
.money-panel .flow-bar-fill { height: 100%; border-radius: 6px; }
.money-panel .flow-bar-fill.in { background: #3ecf8e; }
.money-panel .flow-bar-fill.out { background: #e0a13f; }
.money-panel-total { display: flex; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--line); font-size: 12.5px; color: var(--ink-soft); }
.money-flow-net { display: flex; justify-content: space-between; margin-top: 14px; padding: 12px 16px; border-radius: var(--radius-sm); background: rgba(91,141,239,0.08); border: 1px solid rgba(91,141,239,0.25); font-size: 13.5px; font-weight: 600; }
@media (max-width: 640px) { .money-flow-split { grid-template-columns: 1fr; } }
.deduction-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.deduction-table th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .03em; color: var(--ink-dim); padding: 6px 10px; border-bottom: 1px solid var(--line); }
.deduction-table td { padding: 8px 10px; border-bottom: 1px solid rgba(255,255,255,0.04); }
.deduction-table tr:hover td { background: rgba(255,255,255,0.02); }

/* ---- Social login buttons ---- */
.social-login-col { display: flex; flex-direction: column; gap: 8px; margin: 16px 0; }
.social-btn {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line);
  background: var(--panel-raised); color: var(--ink); font-size: 14px; font-weight: 500;
  text-decoration: none; cursor: pointer; transition: border-color .15s ease, background .15s ease;
}
.social-btn:hover:not(.disabled) { border-color: var(--accent); background: rgba(91,141,239,0.08); }
.social-btn.disabled { opacity: .4; cursor: not-allowed; }
.social-icon { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; font-size: 12px; font-weight: 700; border-radius: 50%; background: rgba(255,255,255,0.08); }
.or-divider { display: flex; align-items: center; gap: 10px; margin: 6px 0 12px; color: var(--ink-dim); font-size: 12px; }
.or-divider::before, .or-divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }

/* ---- Simulator tab ---- */
.sim-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px; margin: 14px 0 20px; }
.sim-field-inline { margin: 0; min-width: 160px; }
.sim-streams { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
.sim-stream-row {
  display: grid; grid-template-columns: auto 1.3fr 0.9fr 0.9fr 1.6fr auto; gap: 10px; align-items: center;
  padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel-raised);
  cursor: pointer; transition: border-color .15s ease;
}
.sim-stream-row-active { border-color: var(--accent); background: rgba(91,141,239,0.06); }
.sim-stream-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.sim-flow-wrap { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 10px; background: var(--panel-raised); margin-bottom: 8px; }
#simFlowDiagram { width: 100%; height: 300px; display: block; }
#simFlowDiagram .sim-node:hover circle { filter: brightness(1.15); }
.sim-stream-row input { width: 100%; }
.sim-stream-num { display: flex; flex-direction: column; gap: 3px; }
.sim-stream-num label { font-size: 10.5px; color: var(--ink-dim); text-transform: uppercase; letter-spacing: .03em; }
.sim-stream-toggle { display: flex; gap: 6px; }
.sim-toggle-btn {
  flex: 1; font-size: 11.5px; padding: 7px 8px; border-radius: 6px; border: 1px solid var(--line);
  background: transparent; color: var(--ink-soft); cursor: pointer; transition: all .15s ease;
}
.sim-toggle-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
.sim-remove-btn {
  width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--line); background: transparent;
  color: var(--ink-dim); cursor: pointer; font-size: 16px; line-height: 1;
}
.sim-remove-btn:hover { border-color: var(--bad); color: var(--bad); }
.sim-chart-wrap { position: relative; margin-top: 22px; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 14px; background: var(--panel-raised); }
.sim-legend { display: flex; gap: 18px; margin-bottom: 8px; font-size: 12.5px; color: var(--ink-soft); }
.sim-legend-item { display: flex; align-items: center; gap: 6px; }
.sim-swatch { display: inline-block; width: 12px; height: 3px; border-radius: 2px; }
.sim-swatch-capital { background: #5b8def; }
.sim-swatch-income { background: #3ecf8e; }
#simChart { width: 100%; height: 260px; display: block; }
.sim-chart-tooltip { position: absolute; pointer-events: none; }
.sim-summary { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
.sim-summary-card { flex: 1; min-width: 200px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel-raised); }
.sim-summary-label { font-size: 11.5px; color: var(--ink-dim); text-transform: uppercase; letter-spacing: .03em; margin-bottom: 6px; }
.sim-summary-value { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; color: #5b8def; }
.sim-summary-value.income { color: #3ecf8e; }

@media (max-width: 640px) {
  .sim-stream-row { grid-template-columns: 1fr; }
}

/* ---- Cushion fund wizard ---- */
.wizard-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-bright); }
.wizard-dot.active { background: var(--accent); }
.wizard-dot.done { background: var(--good); }

/* ---- Learn tab: FAQ, plain scrollable list ---- */
.faq-category-label { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-dim); margin: 22px 0 8px; }
.faq-category-label:first-child { margin-top: 6px; }
.faq-item {
  border: 1px solid var(--line); border-radius: var(--radius-sm); margin-bottom: 10px; background: var(--panel-raised); padding: 14px 16px;
}
.faq-question-static { font-size: 14.5px; font-weight: 700; color: #fff; margin-bottom: 8px; }
.faq-answer-static { font-size: 13.5px; line-height: 1.6; color: var(--ink-soft); }
.faq-source { margin-top: 10px; font-size: 12px; color: var(--ink-dim); }
.faq-source a { color: #5b8def; }
.faq-empty { padding: 14px 0; color: var(--ink-dim); font-size: 13.5px; }
.ask-claude-excerpt {
  margin-top: 10px; padding: 10px 12px; border-left: 3px solid var(--accent); background: rgba(91,141,239,0.06);
  font-size: 12.5px; font-style: italic; color: var(--ink-soft); line-height: 1.55;
}
